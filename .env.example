# Copier dans .env.local et remplir avec la config web du projet Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Mettre à 1 pour utiliser les émulateurs locaux (npm run emulators)
VITE_USE_EMULATORS=

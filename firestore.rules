rules_version = '2';

// Disciply : règles d'accès.
// Rôles : master (administrateur de l'application, tous les campus), admin (pasteur d'un campus),
// shepherd (berger d'une famille), assistant (assistant berger), maker (faiseur de disciples).
// Toutes les données portent un campusId : un campus ne voit jamais les données d'un autre.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Qui suis-je ----------
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().active == true; }
    function role() { return me().role; }
    function myCampus() { return me().campusId; }
    function myFamily() { return me().familyId; }
    // Le super admin est UNIQUEMENT le tout premier compte (celui de l'installation).
    function isMaster() { return active() && role() == 'master'
      && get(/databases/$(database)/documents/meta/bootstrap).data.masterId == request.auth.uid; }
    // Pasteur principal : les mêmes accès que le super admin, sur tous les campus.
    function isGlobal() { return isMaster() || (active() && role() == 'pastor'); }
    function isAdminOf(c) { return isGlobal() || (active() && role() == 'admin' && myCampus() == c); }
    function inCampus(c) { return isGlobal() || (active() && !(role() in ['master', 'pastor']) && myCampus() == c); }
    function isLeader() { return active() && role() in ['shepherd', 'assistant']; }
    function isShepherd() { return active() && role() == 'shepherd'; }
    function isMaker() { return active() && role() == 'maker'; }
    function leads(c, f) { return isLeader() && myCampus() == c && myFamily() == f; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function unchanged(k) { return request.resource.data[k] == resource.data[k]; }
    function validRole(r) { return r in ['master', 'pastor', 'admin', 'shepherd', 'assistant', 'maker']; }

    // ---------- Installation : le tout premier compte devient administrateur de l'application ----------
    match /meta/bootstrap {
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.masterId == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master';
    }

    // ---------- Campus ----------
    match /campuses/{campusId} {
      allow read: if active();
      allow create, update, delete: if isGlobal();
    }

    // ---------- Réglages d'un campus ----------
    match /settings/{campusId} {
      allow read: if inCampus(campusId);
      allow write: if isAdminOf(campusId);
    }

    // ---------- Familles de disciples ----------
    match /families/{familyId} {
      allow read: if inCampus(resource.data.campusId);
      allow create: if isAdminOf(request.resource.data.campusId);
      allow update: if isAdminOf(resource.data.campusId) && unchanged('campusId');
      allow delete: if isAdminOf(resource.data.campusId);
    }

    // ---------- Programme de service ----------
    match /services/{serviceId} {
      allow read: if inCampus(resource.data.campusId);
      allow create: if isAdminOf(request.resource.data.campusId);
      allow update: if isAdminOf(resource.data.campusId) && unchanged('campusId');
      allow delete: if isAdminOf(resource.data.campusId);
    }

    // ---------- Profils des ouvriers ----------
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdminOf(resource.data.campusId)
        || (active() && resource.data.campusId == myCampus() && resource.data.familyId == myFamily()));
      allow list: if isAdminOf(resource.data.campusId)
        || (active() && resource.data.campusId == myCampus() && resource.data.familyId == myFamily())
        // Pour envoyer le rapport compilé : le berger retrouve le ou les pasteurs de son campus.
        || (isLeader() && resource.data.campusId == myCampus() && resource.data.role == 'admin');

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.active == true
        && validRole(request.resource.data.role)
        && (
          (request.resource.data.role == 'master'
            && !exists(/databases/$(database)/documents/meta/bootstrap)
            && existsAfter(/databases/$(database)/documents/meta/bootstrap))
          ||
          (request.resource.data.inviteId is string && inviteOk(request.resource.data.inviteId, request.resource.data))
        );

      allow update: if
        // Pasteur ou administrateur : tout, sauf donner le rôle d'administrateur de l'application.
        (isAdminOf(resource.data.campusId) && isAdminOf(request.resource.data.campusId)
          && request.resource.data.role != 'master'
          // Seul le super admin nomme ou retire un pasteur principal.
          && ((request.resource.data.role != 'pastor' && resource.data.role != 'pastor') || isMaster()))
        // Chacun : son nom, son téléphone, son sexe, son thème.
        || (request.auth.uid == uid && onlyChanges(['name', 'phone', 'theme', 'gender']))
        // L'administrateur de l'application choisit le campus sur lequel il travaille.
        || (request.auth.uid == uid && isGlobal() && onlyChanges(['campusId']))
        // Le berger nomme ou retire un assistant parmi les faiseurs de sa famille.
        || (isShepherd() && resource.data.campusId == myCampus() && resource.data.familyId == myFamily()
            && resource.data.role in ['maker', 'assistant'] && request.resource.data.role in ['maker', 'assistant']
            && onlyChanges(['role']));
      allow delete: if false;
    }

    function inviteOk(inviteId, data) {
      let before = get(/databases/$(database)/documents/invitations/$(inviteId)).data;
      let after = getAfter(/databases/$(database)/documents/invitations/$(inviteId)).data;
      return before.usedBy == null
        && after.usedBy == request.auth.uid
        && before.email.lower() == request.auth.token.email.lower()
        && before.role == data.role
        && before.campusId == data.campusId
        && before.familyId == data.familyId
        && data.role != 'master';
    }

    // ---------- Invitations ----------
    // Lisibles par leur identifiant secret (le lien), jamais listables sans droit.
    match /invitations/{inviteId} {
      allow get: if true;
      allow list: if isAdminOf(resource.data.campusId)
        || (isShepherd() && resource.data.campusId == myCampus() && resource.data.familyId == myFamily());
      allow create: if request.resource.data.usedBy == null && request.resource.data.role != 'master'
        && (request.resource.data.role != 'pastor' || isMaster()) && (
        isGlobal()
        || (isAdminOf(request.resource.data.campusId) && request.resource.data.role in ['admin', 'shepherd', 'assistant', 'maker'])
        || (isShepherd() && request.resource.data.role in ['maker', 'assistant']
            && request.resource.data.campusId == myCampus() && request.resource.data.familyId == myFamily()));
      allow update: if signedIn()
        && resource.data.usedBy == null
        && request.auth.token.email.lower() == resource.data.email.lower()
        && onlyChanges(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid;
      allow delete: if isAdminOf(resource.data.campusId)
        || (isShepherd() && resource.data.campusId == myCampus() && resource.data.familyId == myFamily() && resource.data.usedBy == null);
    }

    // ---------- Chiffres d'une famille (visibles par ses faiseurs, sans le détail des âmes) ----------
    match /familyStats/{familyId} {
      allow get: if isAdminOf(resource.data.campusId)
        || (active() && resource.data.campusId == myCampus() && myFamily() == familyId);
      allow write: if request.resource.data.familyId == familyId && (
        isAdminOf(request.resource.data.campusId) || leads(request.resource.data.campusId, familyId));
    }

    // ---------- Familles d'impact (FI le jeudi, FI jeunes le mardi) ----------
    match /impactFamilies/{id} {
      allow read: if inCampus(resource.data.campusId);
      allow create: if isAdminOf(request.resource.data.campusId);
      allow update: if isAdminOf(resource.data.campusId) && unchanged('campusId');
      allow delete: if isAdminOf(resource.data.campusId);
    }

    // ---------- Âmes ----------
    function canSeeSoul(s) {
      return isAdminOf(s.campusId)
        || leads(s.campusId, s.familyId)
        || (isMaker() && s.campusId == myCampus()
            && (s.makerId == request.auth.uid || (s.createdBy == request.auth.uid && s.makersUntil > request.time)));
    }
    // La famille de la personne sert à ce culte, et la fenêtre d'enregistrement est ouverte.
    function serviceOpen(serviceId, untilField) {
      let sv = get(/databases/$(database)/documents/services/$(serviceId)).data;
      return sv.campusId == myCampus() && sv.familyId == myFamily()
        && request.time >= sv.opensAt && request.time < sv[untilField];
    }

    match /souls/{soulId} {
      allow read: if canSeeSoul(resource.data);

      allow create: if request.resource.data.createdBy == request.auth.uid && (
        isAdminOf(request.resource.data.campusId)
        || (leads(request.resource.data.campusId, request.resource.data.familyId)
            && serviceOpen(request.resource.data.serviceId, 'leadersUntil'))
        || (isMaker() && request.resource.data.campusId == myCampus() && request.resource.data.familyId == myFamily()
            && request.resource.data.makerId == null
            && serviceOpen(request.resource.data.serviceId, 'makersUntil')
            && request.resource.data.makersUntil == get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.makersUntil));

      allow update: if unchanged('campusId') && unchanged('createdBy') && (
        isAdminOf(resource.data.campusId)
        // Berger et assistant : tout dans leur famille, plus le transfert vers une autre famille.
        || (leads(resource.data.campusId, resource.data.familyId)
            && (unchanged('familyId') || onlyChanges(['familyId', 'makerId', 'updatedAt', 'updatedBy', 'history'])))
        // Faiseur : le suivi des âmes qui lui sont confiées, sans changer d'attribution.
        || (isMaker() && resource.data.campusId == myCampus() && resource.data.makerId == request.auth.uid
            && unchanged('makerId') && unchanged('familyId'))
        // Faiseur : corriger une âme qu'il vient d'enregistrer, le jour même.
        || (isMaker() && resource.data.createdBy == request.auth.uid && resource.data.makersUntil > request.time
            && unchanged('makerId') && unchanged('familyId') && unchanged('makersUntil')));
      allow delete: if isAdminOf(resource.data.campusId);

      match /notes/{noteId} {
        allow read: if canSeeSoul(get(/databases/$(database)/documents/souls/$(soulId)).data);
        allow create: if canSeeSoul(get(/databases/$(database)/documents/souls/$(soulId)).data)
          && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    // ---------- Présences ----------
    match /attendances/{attId} {
      allow read: if isAdminOf(resource.data.campusId)
        || leads(resource.data.campusId, resource.data.familyId)
        || (isMaker() && resource.data.campusId == myCampus() && resource.data.makerId == request.auth.uid);
      allow create, update: if isAdminOf(request.resource.data.campusId)
        || leads(request.resource.data.campusId, request.resource.data.familyId)
        || (isMaker() && request.resource.data.campusId == myCampus() && request.resource.data.makerId == request.auth.uid
            && get(/databases/$(database)/documents/souls/$(request.resource.data.soulId)).data.makerId == request.auth.uid);
      allow delete: if isAdminOf(resource.data.campusId);
    }

    // ---------- Notifications dans l'app ----------
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if request.resource.data.by == request.auth.uid && request.resource.data.read == false
        && (isAdminOf(request.resource.data.campusId) || (isLeader() && request.resource.data.campusId == myCampus()));
      allow update: if signedIn() && resource.data.userId == request.auth.uid && onlyChanges(['read']);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ---------- Rapport du lundi du faiseur ----------
    match /reports/{id} {
      // Un rapport pas encore envoyé : on peut vérifier qu'il n'existe pas (rien n'est révélé).
      allow get: if active() && resource == null;
      allow read: if isAdminOf(resource.data.campusId)
        || leads(resource.data.campusId, resource.data.familyId)
        || (signedIn() && resource.data.makerId == request.auth.uid);
      allow create, update: if (isMaker() || isLeader())
        && request.resource.data.makerId == request.auth.uid
        && request.resource.data.campusId == myCampus() && request.resource.data.familyId == myFamily();
    }

    // ---------- Rapport compilé de la famille, envoyé au pasteur ----------
    match /familyReports/{id} {
      allow get: if active() && resource == null;
      allow read: if isAdminOf(resource.data.campusId) || leads(resource.data.campusId, resource.data.familyId);
      allow create, update: if leads(request.resource.data.campusId, request.resource.data.familyId)
        && request.resource.data.sentBy == request.auth.uid;
    }
  }
}
